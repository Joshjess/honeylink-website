# Formspree form ID (required for contact form) — the suffix from
# https://formspree.io/f/<ID>
FORMSPREE_FORM_ID=xykvzvdq

# SvelteKit origin for CSRF protection (required in production)
ORIGIN=https://honeylink.nl

# Node.js port inside container (default 3000)
PORT=3000

# Reverse-proxy headers (required when running behind Coolify/Traefik/Caddy
# so SvelteKit sees the real client protocol and host, not the proxy's)
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host

# Node heap size — tune to ~75% of the container memory limit.
# Example: 1536 MiB on a CPX11 (2 GB RAM) Hetzner VPS.
NODE_OPTIONS=--max-old-space-size=1536
